    <name>deutsch-cards-app</name>
    <description>App to learn german words</description>
    <properties>
        <jakarta-servlet.version>5.0.0</jakarta-servlet.version>
        <java.version>17</java.version>

        <word.cards.folder>${basedir}/src/main/resources/swagger</word.cards.folder>
        <templates.folder>${basedir}/src/main/resources/swagger/templates</templates.folder>
        <argLine>-Dfile.encoding=UTF-8</argLine>

        <openapi.generator.plugin.version>7.7.0</openapi.generator.plugin.version>
        <formatter.maven.plugin.version>2.14.0</formatter.maven.plugin.version>
        <commons-collections4.version>4.1</commons-collections4.version>
        <apache.commons-lang3.version>3.11</apache.commons-lang3.version>
        <vaadin.version>24.7.3</vaadin.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <spring-ai.version>1.1.8</spring-ai.version>
    </properties>

    <repositories>
        <repository>
            <id>Vaadin Directory</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
            <snapshots>
