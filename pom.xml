    <profiles>
        <profile>
            <id>production</id> 
            <properties>
                <vaadin.productionMode>true</vaadin.productionMode>
                <vaadin.frontend.hotdeploy>false</vaadin.frontend.hotdeploy>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-core</artifactId>
                    <exclusions>
                        <exclusion> 
                            <groupId>com.vaadin</groupId>
                            <artifactId>vaadin-dev</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>prepare-frontend</goal>
                                    <goal>build-frontend</goal>
                                </goals>
                                <phase>compile</phase> 
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>com.kniazev.cards.word.WordCardsApplication</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
        <profile>
            <id>base</id>
            
            <build>
                <finalName>deutsche-cards-app</finalName>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-compiler-plugin</artifactId>
                            <configuration>
                                <annotationProcessorPaths>
                                    <path>
                                        <groupId>org.projectlombok</groupId>
                                        <artifactId>lombok</artifactId>
                                        <version>1.18.32</version>
                                    </path>
                                </annotationProcessorPaths>
                            </configuration>
                        </plugin>
                        <plugin>
                            <groupId>net.revelc.code.formatter</groupId>
                            <artifactId>formatter-maven-plugin</artifactId>
                            <version>2.14.0</version>
                            <configuration>
                                <compilerSource>1.17</compilerSource>
                                <compilerCompliance>1.17</compilerCompliance>
                                <compilerTargetPlatform>1.17</compilerTargetPlatform>
                                <directories>
                                    <directory>${project.basedir}/target/generated-sources/openapi/src/main/java/</directory>
                                </directories>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>

                <plugins>

                    <plugin>
                        <groupId>org.openapitools</groupId>
                        <artifactId>openapi-generator-maven-plugin</artifactId>
                        <version>${openapi.generator.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>generate-cards-word-api-delegate</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <inputSpec>${word.cards.folder}/word-cards.yaml</inputSpec>
                                    <generatorName>spring</generatorName>
                                    <generateApiTests>false</generateApiTests>
                                    <generateApiDocumentation>false</generateApiDocumentation>
                                    <generateModelTests>false</generateModelTests>
                                    <generateModelDocumentation>false</generateModelDocumentation>
                                    <apiPackage>${project.groupId}.cards.word.api.delegate</apiPackage>
                                    <modelPackage>${project.groupId}.cards.word.api.model</modelPackage>
                                    <templateDirectory>${templates.folder}</templateDirectory>
                                    <generateSupportingFiles>false</generateSupportingFiles>
                                    <configOptions>
                                        <java11>true</java11>
                                        <library>spring-boot</library>
                                        <delegatePattern>true</delegatePattern>
                                        <dateLibrary>java11-offsetdatetime</dateLibrary>
                                        <useTags>true</useTags>
                                        <useBeanValidation>true</useBeanValidation>
                                        <openApiNullable>true</openApiNullable>
                                        <useJakartaEe>true</useJakartaEe>
                                    </configOptions>
                                    <environmentVariables>
                                        <supportingFiles>ApiUtil.java</supportingFiles>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                            <execution>
                                <id>generate-cards-word-test-api-client</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <inputSpec>${word.cards.folder}/word-cards.yaml</inputSpec>
                                    <generatorName>java</generatorName>
                                    <generateApiTests>false</generateApiTests>
                                    <generateModelTests>false</generateModelTests>
                                    <library>restclient</library>
                                    <modelPackage>${project.groupId}.cards.word.api.model</modelPackage>
                                    <apiPackage>${project.groupId}.cards.word.test.client.api</apiPackage>
                                    <invokerPackage>${project.groupId}.test.cards.word.test.client.invoker</invokerPackage>
                                    <output>${project.build.directory}/generated-test-sources/openapi</output>
                                    <skipOverwrite>true</skipOverwrite>
                                    <generateModels>false</generateModels>
                                    <configOptions>
                                        <dateLibrary>java11-localdatetime</dateLibrary>
                                    </configOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>net.revelc.code.formatter</groupId>
                        <artifactId>formatter-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>format-word-cards-api</id>
                                <phase>process-sources</phase>
                                <goals>
                                    <goal>format</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*Tests.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
    </profiles>

</project>

